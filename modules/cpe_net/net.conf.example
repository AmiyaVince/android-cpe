# cpe_net 配置（部署时复制到 /data/adb/cpe/net.conf）
# 改完保存即可，看门狗每 30 秒热加载一次，不用重启。

# ---- 共享网段（仅当 ColorOS 没有接管共享时由本模块自己配）----
# ColorOS 的以太网共享网段是 10.68.92.x，这里沿用同一网段便于对照。
GW=10.68.92.161
DHCP_START=10.68.92.100
DHCP_END=10.68.92.200
DNS1=223.5.5.5
DNS2=114.114.114.114

# 下发给客户端的 MTU。5G 上行 MTU 通常只有 1400，设大了大包会卡。
DHCP_MTU=1400

# ---- 管理地址 ----
# 上游光猫/FTTR 被降级成二层交换机后，下游客户端和它不在同一网段。
# 给 eth0 挂一个同网段的地址，手机就能直接管理它：
#   curl --interface 192.168.1.250 http://192.168.1.1/
# 置空可关闭。
MGMT_ALIAS=192.168.1.250/24

# ---- 以太网共享拉起工具 ----
# app_process + 反射调 TetheringManager 编出来的 dex。
# 没有它就只能靠 UI 开关：开机不自启，链路抖动掉了也回不来。
TETHER_HELPER=/data/adb/modules/cpe_net/tetherctl.dex

# 看门狗间隔（秒）
POLL=30
